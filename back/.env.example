# Ambiente: development | production
NODE_ENV=development

# Porta do servidor Node
PORT=3000

# Conexão com o banco (usuario:senha@host:porta/banco)
DATABASE_URL="postgresql://cead_app:TROQUE_ESTA_SENHA@localhost:5432/cead_db?schema=public"

# Segredo para assinar os tokens JWT (OBRIGATÓRIO em produção)
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Origem(ns) do frontend liberadas no CORS (separe por vírgula)
CORS_ORIGIN=http://localhost:5173

# URL pública do frontend (usada nos links de e-mail)
FRONTEND_URL=http://localhost:5173

# Atrás do Nginx use 1 (o limite de tentativas usa o IP real do cliente)
TRUST_PROXY=0

# Tentativas de login/recuperação de senha por IP a cada 15 minutos
LOGIN_RATE_LIMIT=10

# Comprovantes dos relatórios de viagem (PDF/JPG/PNG). Inclua esta pasta no backup!
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=10

# Banco exclusivo para os testes automatizados (será APAGADO a cada execução)
# TEST_DATABASE_URL="postgresql://cead_app:SENHA@localhost:5432/cead_db_test?schema=public"

# E-mail (SMTP). Sem SMTP_HOST, usa o Gmail/Google Workspace.
# Para Gmail, use uma "Senha de app" (não a senha da conta).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Challenger CEAD <cticead@ufpi.edu.br>"
